{
  "scenario_id": "pub_05_audio_asr_ambiguity",
  "metadata": {
    "modality": "audio",
    "difficulty": "L2",
    "description": "Raw audio. Turn 1 names the destination indistinctly (it can be heard as Austin or Boston). A good agent notices its transcription is unsure, CLARIFIES before acting, then acts on the city the user confirms in turn 2. Acting on a guess loses points."
  },
  "events": [
    {
      "timestamp_ms": 100,
      "event_type": "user_audio_chunk",
      "_reference_text": "book a flight to Boston",
      "payload": {
        "audio_ref": "audio/pub_05_turn1.mp3",
        "duration_ms": 1400,
        "end_of_turn": true
      }
    },
    {
      "timestamp_ms": 4200,
      "event_type": "user_audio_chunk",
      "_reference_text": "I said Boston.",
      "payload": {
        "audio_ref": "audio/pub_05_turn2.mp3",
        "duration_ms": 900,
        "end_of_turn": true
      }
    }
  ],
  "ground_truth": {
    "checkpoints": [
      {
        "id": "asked_before_acting",
        "type": "clarification",
        "any_of": ["did you mean", "did you say", "confirm", "austin or boston", "boston or austin", "which city"],
        "before_ms": 4200,
        "weight": 0.3
      },
      {
        "id": "no_premature_search",
        "type": "tool_not_called",
        "tool": "flight_search",
        "before_ms": 4200,
        "weight": 0.25
      },
      {
        "id": "search_boston",
        "type": "tool_called",
        "tool": "flight_search",
        "args_subset": {"destination": ["boston", "bos"]},
        "after_ms": 4200,
        "must_complete": true,
        "weight": 0.3
      },
      {
        "id": "final_boston",
        "type": "final_response_contains",
        "any_of": ["boston", "fl-bos"],
        "weight": 0.15
      }
    ],
    "latency": {
      "respond_to": [
        {"event_index": 0, "full_credit_ms": 800, "zero_credit_ms": 2500},
        {"event_index": 1, "full_credit_ms": 800, "zero_credit_ms": 2500}
      ]
    }
  }
}
